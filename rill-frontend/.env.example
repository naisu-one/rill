# Local dev. `vite dev` serves on port 8080 — the Lovable config wrapper
# (@lovable.dev/vite-tanstack-config) overrides the `server.port: 5173` in vite.config.ts, so
# trust the port the dev server prints, not the config file.
# Point the backend at it too, so OAuth sign-in redirects here: RILL_STUDIO_URL=http://localhost:8080
VITE_RILL_API_URL=https://api.rill.naisu.one/api

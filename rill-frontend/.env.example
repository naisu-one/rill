# Local dev uses port 5173. If it is occupied, use the actual URL Vite prints.
# Point Rust at the same origin for OAuth consent: RILL_STUDIO_URL=http://localhost:5173
VITE_RILL_API_URL=http://localhost:3939/api

# Must match the backend SUI_NETWORK. Allowed values: testnet (default), mainnet.
# Mainnet requires a complete registry and explicitly deployed Rill contract IDs on the backend.
VITE_SUI_NETWORK=testnet
